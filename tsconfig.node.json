{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["ES2020"],

        "module": "esnext",
        "moduleResolution": "bundler",

        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noImplicitAny": true,

        "allowJs": true,
        "checkJs": false,

        "skipLibCheck": true,
        "types": ["node"],

        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
    },
    "include": [
        "vite.config.js",
        "vite.config.ts",
        "vitest.config.js",
        "vitest.config.ts",
        "eslint.config.js",
        "eslint.config.ts"
    ]
}
